# Server Configuration
PORT=8080
NODE_ENV=production
 
# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/payments_db
DB_POOL_MIN=2
DB_POOL_MAX=10
 
# Cloud & Integrations
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=payments-receipts-archive
STRIPE_API_KEY=sk_test_placeholder_name_only
 
# Monitoring & Logging
LOG_LEVEL=info
DATADOG_API_KEY=placeholder_env_only
